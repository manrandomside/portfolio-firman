---
import { Font } from "astro:assets";
import "../styles/global.css";
import { ME } from "../data/site.js";
import { altPath } from "../lib/i18n.js";

const { lang, path, title, description } = Astro.props;
const here = new URL(path, Astro.site);
const twin = new URL(altPath(path), Astro.site);
const [idUrl, enUrl] = lang === "id" ? [here, twin] : [twin, here];

// tells search engines who this page is about
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: ME.name,
  jobTitle: "Web Developer",
  url: new URL("/", Astro.site).href,
  email: "mailto:" + ME.email,
  address: { "@type": "PostalAddress", addressRegion: "Bali", addressCountry: "ID" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Universitas Udayana" },
  sameAs: [ME.github, ME.linkedin, ME.instagram]
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={idUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:site_name" content={ME.name} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-poppins" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-onest" preload={[{ weight: 400 }]} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- set before first paint so reveal-on-scroll never flashes visible content -->
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <slot />
    <script>
      import { initReveal, initSmoothScroll } from "../scripts/motion.js";
      initReveal();
      initSmoothScroll();
    </script>
  </body>
</html>
