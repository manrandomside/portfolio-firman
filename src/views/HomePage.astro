---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Intro from "../components/Intro.astro";
import Hero from "../components/Hero.astro";
import Statement from "../components/Statement.astro";
import Flow from "../components/Flow.astro";
import Proof from "../components/Proof.astro";
import Featured from "../components/Featured.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import ProjectSheet from "../components/ProjectSheet.astro";
import CertDialog from "../components/CertDialog.astro";
import { UI } from "../data/site.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
const path = lang === "id" ? "/" : "/en/";
---
<Base lang={lang} path={path} title={t(UI.meta.home.title, lang)} description={t(UI.meta.home.description, lang)}>
  <Intro />
  <Nav lang={lang} path={path} />
  <main>
    <Hero lang={lang} />
    <Flow lang={lang} />
    <Proof lang={lang} />
    <Featured lang={lang} />
    <Statement lang={lang} />
    <Process lang={lang} />
    <About lang={lang} />
    <Experience lang={lang} />
    <Faq lang={lang} />
  </main>
  <Contact lang={lang} />
  <ProjectSheet lang={lang} />
  <CertDialog lang={lang} />
</Base>
