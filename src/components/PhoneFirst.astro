---
import { Image } from "astro:assets";
import { PHONES, PROJECTS, UI } from "../data/site.js";
import { t } from "../lib/i18n.js";
import { img } from "../data/images.js";

const { lang } = Astro.props;
const name = (slug: string) => PROJECTS.find(p => p.slug === slug)!.name;
---
<!-- Phone first: the promise on the left, a wall of real phone screens on the right. The three columns drift at
     different speeds as the page scrolls; each screen opens its project. Reduced motion keeps them still. -->
<section class="pf" id="hp" aria-labelledby="pf-title">
  <div class="in pf-grid marks">
    <div class="pf-copy">
      <p class="label rv">{t(UI.phones.eyebrow, lang)}</p>
      <h2 id="pf-title" class="rv" style="--d:.08s">{t(UI.phones.title[0], lang)} <em>{t(UI.phones.title[1], lang)}</em></h2>
      <p class="lead rv" style="--d:.16s">{t(UI.phones.lead, lang)}</p>
      <ul class="pf-points rv" style="--d:.24s">{UI.phones.points.map(p => <li>{t(p, lang)}</li>)}</ul>
    </div>
    <div class="pf-wall">
      {PHONES.map((col, c) => (
        <div class="pf-col" style={`--c:${c}`}>
          {col.map(ph => (
            <button type="button" class="pf-phone" data-slug={ph.slug} aria-haspopup="dialog" data-cursor={name(ph.slug)}>
              <Image src={img(ph.image)} alt={`${t(UI.phones.alt, lang)} ${name(ph.slug)}`} widths={[220, 400]} sizes="(min-width: 900px) 180px, 30vw" class="print-grey" />
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .pf { overflow: clip; padding-block: clamp(56px, min(8vw, 12svh), 112px) 0; box-shadow: inset 0 1px var(--line); }
  .pf-grid { display: grid; gap: 40px; }
  .pf-copy { display: grid; gap: 14px; align-content: center; }
  .pf-points { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pf-points li { font: 500 13px/1 var(--f-label); padding: 10px 14px; border: 1.5px solid var(--ink); border-radius: 99px; }
  .pf-points li:first-child { background: var(--ink); color: var(--bg); }

  /* the wall is cut off at the bottom like a sheet running off the press */
  .pf-wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 20px); height: clamp(420px, 70svh, 640px); overflow: hidden; align-items: start;
    mask-image: linear-gradient(#000 78%, transparent); }
  .pf-col { display: grid; gap: clamp(10px, 1.6vw, 20px); translate: 0 var(--y, 0px); will-change: translate; }
  .pf-col:nth-child(2) { margin-top: 12%; }
  .pf-col:nth-child(3) { margin-top: 5%; }
  .pf-phone { all: unset; box-sizing: border-box; display: block; aspect-ratio: 390 / 820; overflow: hidden; cursor: pointer;
    border: 5px solid var(--ink); border-radius: clamp(16px, 2vw, 24px); background: var(--ink); transition: transform .5s var(--ease); }
  .pf-phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: clamp(11px, 1.5vw, 18px); }
  .pf-phone:hover { transform: translateY(-6px); }
  .pf-phone:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  @media (min-width: 900px) {
    .pf { padding-block: 0; }
    .pf-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); height: min(100svh, 860px); min-height: 560px; }
    .pf-copy { padding-block: 48px; }
    .pf-wall { height: 100%; }
    .pf-col:first-child { margin-top: -8%; }
  }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  // the outer columns rise and the middle one sinks while the section crosses the screen
  const sec = document.getElementById("hp")!;
  const cols = [...sec.querySelectorAll<HTMLElement>(".pf-col")];
  const speed = [-90, 70, -140];
  const update = () => {
    const r = sec.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
    cols.forEach((c, i) => c.style.setProperty("--y", `${((p - .5) * speed[i]).toFixed(1)}px`));
  };
  if (!REDUCE) {
    let raf = 0;
    addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); }, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>
