---
import { getImage } from "astro:assets";
import { PROJECTS, CATS, UI } from "../data/site.js";
import { t } from "../lib/i18n.js";
import { img } from "../data/images.js";

const { lang } = Astro.props;
// the sheet is filled in the browser from this list, already in the page's language
const data = await Promise.all(PROJECTS.map(async p => ({
  slug: p.slug,
  name: p.name,
  meta: `${t(CATS[p.cat], lang)} · ${p.year}`,
  story: t(p.story, lang),
  role: t(p.role, lang),
  stack: p.stack.join(" · "),
  live: p.live,
  repo: p.repo,
  award: p.award && { title: t(p.award.title, lang), by: p.award.by, proof: p.award.proof },
  poster: p.cat === "desain" || !!p.phone, // shown whole (contained), not cropped
  image: p.image ? (await getImage({ src: img(p.image), width: 1400, format: "webp" })).src : null,
  alt: `${p.name}: ${t(p.line, lang)}`
})));
const L = { live: t(UI.work.live, lang), code: t(UI.work.code, lang), proof: t(UI.work.proof, lang), role: t(UI.work.role, lang), stack: t(UI.work.stack, lang) };
---
<dialog class="sheet" data-lenis-prevent aria-labelledby="sheet-name">
  <div class="sheet-inner">
    <button type="button" class="sheet-close" data-close aria-label={t(UI.work.close, lang)}>×</button>
    <div class="sheet-media"></div>
    <p class="sheet-meta mono"></p>
    <h2 id="sheet-name" class="sheet-name"></h2>
    <p class="sheet-award"></p>
    <p class="sheet-story"></p>
    <dl class="sheet-facts">
      <div><dt class="mono">{L.role}</dt><dd class="sheet-role"></dd></div>
      <div><dt class="mono">{L.stack}</dt><dd class="sheet-stack"></dd></div>
    </dl>
    <div class="ctas sheet-links"></div>
  </div>
</dialog>
<script type="application/json" id="sheet-data" set:html={JSON.stringify({ items: data, L })} />

<style is:global>
  .sheet { width: min(760px, calc(100% - 24px)); max-height: calc(100dvh - 24px); margin: auto; padding: 0; border: 0; border-radius: 14px; background: var(--bg); color: var(--ink); overflow: auto; overscroll-behavior: contain; }
  .sheet::backdrop { background: rgba(15, 23, 32, .6); backdrop-filter: blur(4px); }
  .sheet[open] { animation: sheetIn .5s var(--ease); }
  @keyframes sheetIn { from { opacity: 0; transform: translateY(24px); } }
  .sheet-inner { position: relative; display: grid; gap: 14px; padding: 20px clamp(18px, 4vw, 36px) 32px; }
  .sheet-close { position: sticky; top: 0; justify-self: end; z-index: 2; width: 44px; height: 44px; margin-bottom: -58px; border-radius: 50%; border: 0; background: var(--ink); color: var(--bg); font-size: 24px; line-height: 1; }
  .sheet-media { border-radius: 10px; overflow: hidden; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
  .sheet-media img { width: 100%; height: auto; max-height: 60vh; object-fit: cover; object-position: top; }
  .sheet-media.poster { background: var(--bg-2); padding: 16px; }
  .sheet-media.poster img { object-fit: contain; }
  .sheet-media.type-only { padding: 40px 24px; font: 700 clamp(34px, 7vw, 56px)/1 var(--f-display); letter-spacing: -.03em; }
  .sheet-meta { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  .sheet-name { font-size: clamp(28px, 5vw, 40px); }
  .sheet-award { font-weight: 600; color: var(--accent-ink); }
  .sheet-award a { margin-left: 8px; font-weight: 400; }
  .sheet-story { max-width: 62ch; }
  .sheet-facts { display: grid; gap: 12px; margin: 6px 0 4px; }
  .sheet-facts div { display: grid; gap: 2px; padding-top: 12px; border-top: 1px solid var(--line); }
  .sheet-facts dt { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .sheet-facts dd { margin: 0; }
  .sheet-links:empty { display: none; }
  @media (min-width: 640px) { .sheet-facts { grid-template-columns: 1fr 1fr; gap: 24px; } }
</style>

<script>
  import { lockScroll } from "../scripts/motion.js";

  const dialog = document.querySelector<HTMLDialogElement>(".sheet")!;
  const { items, L } = JSON.parse(document.getElementById("sheet-data")!.textContent!);
  const q = (s: string) => dialog.querySelector<HTMLElement>(s)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  let opener: HTMLElement | null = null;

  function open(slug: string, from: HTMLElement) {
    const p = items.find((i: { slug: string }) => i.slug === slug);
    if (!p) return;
    opener = from;
    const media = q(".sheet-media");
    media.className = "sheet-media" + (p.poster ? " poster" : "") + (p.image ? "" : " type-only");
    media.innerHTML = p.image ? `<img src="${p.image}" alt="${esc(p.alt)}">` : esc(p.name);
    q(".sheet-meta").textContent = p.meta;
    q(".sheet-name").textContent = p.name;
    q(".sheet-award").innerHTML = p.award ? `${esc(p.award.title)} · ${esc(p.award.by)} <a class="link" href="${p.award.proof}" target="_blank" rel="noopener">${L.proof} ↗</a>` : "";
    q(".sheet-award").hidden = !p.award;
    q(".sheet-story").textContent = p.story;
    q(".sheet-role").textContent = p.role;
    q(".sheet-stack").textContent = p.stack;
    q(".sheet-links").innerHTML = [p.live && `<a class="btn wa" href="${p.live}" target="_blank" rel="noopener">${L.live} ↗</a>`, p.repo && `<a class="btn" href="${p.repo}" target="_blank" rel="noopener">${L.code} ↗</a>`].filter(Boolean).join("");
    dialog.showModal();
    dialog.scrollTop = 0;
    lockScroll(true);
  }

  document.addEventListener("click", e => {
    const card = (e.target as HTMLElement).closest<HTMLElement>("[data-slug]");
    if (card) open(card.dataset.slug!, card);
  });
  dialog.addEventListener("click", e => {
    // a click on the dim backdrop lands on the dialog itself
    if (e.target === dialog || (e.target as HTMLElement).closest("[data-close]")) dialog.close();
  });
  dialog.addEventListener("close", () => { lockScroll(false); opener?.focus(); });
</script>
