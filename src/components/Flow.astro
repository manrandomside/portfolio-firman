---
import { Image } from "astro:assets";
import { UI } from "../data/site.js";
import { t } from "../lib/i18n.js";
import { img } from "../data/images.js";

const { lang } = Astro.props;
const tiles = ["n1", "e1", "b4", "n4", "s1", "e6", "n6", "b2", "n3"];
---
<!-- Real proof of how Firman works: an Instagram-only business turns into its website as you scroll (Early Beauty). -->
<section class="flow dark" id="contoh" aria-labelledby="flow-title">
  <div class="flow-pin">
    <div class="flow-sticky in">
      <div class="flow-copy">
        <h2 id="flow-title">{t(UI.flow.title, lang)}</h2>
        <p class="lead flow-lead">{t(UI.flow.lead, lang)}</p>
        <p class="label">{t(UI.flow.eyebrow, lang)}</p>
        <ul class="flow-facts">{UI.flow.facts.map(f => <li>{t(f, lang)}</li>)}</ul>
        <div class="ctas flow-ctas">
          <a class="btn" href="https://earlybeauty.pages.dev" target="_blank" rel="noopener">{t(UI.flow.live, lang)} ↗</a>
          <button type="button" class="btn ghost-btn" data-slug="early-beauty" aria-haspopup="dialog">{t(UI.flow.story, lang)}</button>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <figure class="phone ph-ig">
          <div class="screen">
            <div class="ig-top">
              <Image src={img("ig/s1")} alt="" width={96} class="ig-avatar" />
              <div><b>earlybeauty.studio</b><span>Eyelash · Nails · Brow</span></div>
            </div>
            <div class="ig-btns"><span>Follow</span><span>Message</span></div>
            <div class="ig-grid">
              {tiles.map(k => <div class="tile"><Image src={img(`ig/${k}`)} alt="" width={180} loading="eager" /></div>)}
            </div>
          </div>
          <figcaption class="mono">{t(UI.hero.igCaption, lang)}</figcaption>
        </figure>
        <span class="stage-arrow mono">→</span>
        <figure class="phone ph-site">
          <div class="screen">
            <span class="site-url">earlybeauty.pages.dev</span>
            <div class="site-shot"><Image src={img("shots/early-beauty-phone")} alt="" widths={[300, 600]} sizes="300px" /></div>
            <div class="site-targets">{tiles.map(() => <i></i>)}</div>
          </div>
          <figcaption class="mono">{t(UI.hero.siteCaption, lang)}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .flow { position: relative; }
  .flow-pin { position: relative; }
  .flow-sticky { display: grid; gap: 40px; padding-block: clamp(32px, 6vw, 72px) 48px; }
  .js .flow.morph .flow-pin { height: calc(var(--pin-h, 100vh) + var(--travel, 90vh)); }
  /* phones pin only the two phones; wide screens pin the whole section */
  @media (max-width: 899px) {
    .js .flow.morph .flow-sticky { min-height: 100%; align-content: start; }
    .js .flow.morph .stage { position: sticky; top: var(--sticky-top, 64px); }
  }

  
  .flow { background: var(--dark); }
  .flow .screen { border-color: #2e2e2c; }
  .flow .stage-arrow { color: var(--accent); }
  .flow-copy { display: grid; gap: 18px; align-content: center; }
  .flow-facts { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; }
  .flow-facts li { padding: 6px 12px; border: 1px solid var(--line); border-radius: 99px; background: var(--card); }
  .flow-ctas { margin-top: 8px; }
  .ghost-btn { background: none; cursor: pointer; }

  .stage { --pw: clamp(132px, 37vw, 236px); display: flex; align-items: flex-start; justify-content: center; gap: clamp(10px, 3vw, 28px); }
  .stage-arrow { align-self: center; font-size: 20px; color: var(--muted); margin-top: -28px; }
  .phone { margin: 0; width: var(--pw); display: grid; gap: 12px; justify-items: center; }
  .phone figcaption { font-size: 10px; letter-spacing: .04em; color: var(--muted); text-align: center; }
  .screen { position: relative; width: 100%; aspect-ratio: 390 / 844; border: 7px solid var(--ink); border-radius: calc(var(--pw) * .16); background: #fff; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(15, 23, 32, .55); }
  .screen::before { content: ""; position: absolute; z-index: 3; top: 6px; left: 50%; width: 30%; height: 5%; max-height: 18px; translate: -50% 0; background: var(--ink); border-radius: 99px; }

  .ph-ig { position: relative; z-index: 2; }
  .ph-ig .screen { overflow: visible; padding: 16% 6% 0; display: grid; align-content: start; gap: 6%; font-size: calc(var(--pw) * .052); color: #111; }
  .ig-top { display: flex; align-items: center; gap: 8%; }
  .ig-avatar { width: 30%; aspect-ratio: 1; border-radius: 50%; object-fit: cover; outline: 2px solid #d6249f; outline-offset: 2px; }
  .ig-top b { display: block; font-weight: 600; }
  .ig-top span { color: #666; }
  .ig-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 4%; text-align: center; }
  .ig-btns span { background: #efefef; border-radius: 6px; padding: 4% 0; font-weight: 600; }
  .ig-btns span:first-child { background: #0064d1; color: #fff; }
  .ig-grid, .site-targets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .ig-grid { margin-inline: -6.5%; }
  .tile { aspect-ratio: 1; overflow: hidden; will-change: transform; }
  .tile img { width: 100%; height: 100%; object-fit: cover; }

  .ph-site .screen { background: #1d1416; }
  .site-url { position: absolute; inset: 0; display: grid; place-items: center; font: 400 calc(var(--pw) * .055) var(--f-mono); color: #c9a45f; opacity: .85; }
  .site-shot { position: relative; z-index: 1; }
  .site-shot img { width: 100%; height: auto; }
  .site-targets { position: absolute; inset: 22% 8% 22%; align-content: center; pointer-events: none; visibility: hidden; }
  .site-targets i { aspect-ratio: 1; }

  /* morph state, driven by --p (0 = Instagram, 1 = website) from the script below */
  .js .flow.morph .site-shot { clip-path: inset(0 0 calc((1 - var(--reveal, 1)) * 100%) 0); }
  .js .flow.morph .tile { transform: translate(calc(var(--dx) * var(--e, 0)), calc(var(--dy) * var(--e, 0))) scale(calc(1 + (var(--s) - 1) * var(--e, 0))); opacity: var(--fade, 1); }

  @media (min-width: 900px) {
    .flow-sticky { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; min-height: calc(100svh - 64px); padding-block: 40px; }
    .stage { --pw: clamp(170px, min(17vw, 30svh), 240px); }
    .js .flow.morph .flow-sticky { position: sticky; top: var(--sticky-top, 64px); }
  }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  const flow = document.querySelector<HTMLElement>(".flow")!;
  const pin = flow.querySelector<HTMLElement>(".flow-pin")!;
  const whole = flow.querySelector<HTMLElement>(".flow-sticky")!;
  const stage = flow.querySelector<HTMLElement>(".stage")!;
  const wide = matchMedia("(min-width: 900px)");
  let sticky = whole, stageTop = 0, natH = 0;
  const tiles = [...flow.querySelectorAll<HTMLElement>(".tile")];
  const targets = [...flow.querySelectorAll<HTMLElement>(".site-targets i")];
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (v: number) => 1 - Math.pow(1 - v, 3);

  // measure where each Instagram tile sits and where its slot in the website phone is
  function measure() {
    flow.style.setProperty("--e", "0");
    const navH = document.querySelector<HTMLElement>(".nav")?.offsetHeight ?? 64;
    sticky = wide.matches ? whole : stage;
    // read resting sizes: a stuck element reports its stuck offset, and the stretched section its stretched height
    stage.style.position = "static"; if (!wide.matches) whole.style.minHeight = "0";
    stageTop = stage.offsetTop; natH = whole.offsetHeight;
    stage.style.position = whole.style.minHeight = "";
    const h = wide.matches ? natH : stage.offsetHeight;
    flow.style.setProperty("--pin-h", natH + "px");
    // wide: pin the section under the nav; phones: hold the two phones in the middle of the screen
    flow.style.setProperty("--sticky-top", (wide.matches ? Math.min(navH, innerHeight - h) : Math.max(navH, (innerHeight + navH - h) / 2)) + "px");
    flow.style.setProperty("--travel", (innerWidth < 900 ? 90 : 120) + "vh");
    tiles.forEach((tile, i) => {
      const a = tile.getBoundingClientRect(), b = targets[i].getBoundingClientRect();
      tile.style.setProperty("--dx", b.left + b.width / 2 - (a.left + a.width / 2) + "px");
      tile.style.setProperty("--dy", b.top + b.height / 2 - (a.top + a.height / 2) + "px");
      tile.style.setProperty("--s", String(b.width / a.width));
    });
    update();
  }

  function update() {
    const r = pin.getBoundingClientRect();
    const top = parseFloat(getComputedStyle(flow).getPropertyValue("--sticky-top")) || 0;
    // progress runs while the pinned part is stuck: from its top reaching its sticky position until the pin ends
    const start = r.top + (sticky === whole ? 0 : stageTop);
    const p = clamp((top - start) / Math.max(1, r.height - natH));
    flow.style.setProperty("--e", String(ease(clamp(p / .7))));
    flow.style.setProperty("--fade", String(1 - clamp((p - .6) / .3)));
    flow.style.setProperty("--reveal", String(ease(clamp((p - .45) / .5))));
  }

  // without motion (or without JS) both phones simply sit side by side, the website already shown
  if (!REDUCE) {
    flow.classList.add("morph");
    let raf = 0;
    addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    let t: number;
    addEventListener("resize", () => { clearTimeout(t); t = setTimeout(measure, 150); });
    addEventListener("load", measure);
    document.fonts?.ready.then(measure);
    measure();
  }
</script>
