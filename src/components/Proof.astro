---
import { PROOF } from "../data/site.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
---
<section class="proof" aria-label={lang === "id" ? "Bukti" : "Proof"}>
  <ul class="in proof-row">
    {PROOF.map(p => (
      <li class="rv">
        <strong class="proof-num">{p.word ?? <span data-to={p.value}>{p.value}</span>}</strong>
        <span>{t(p.label, lang)}</span>
      </li>
    ))}
  </ul>
</section>

<style is:global>
  .proof { box-shadow: inset 0 1px var(--ink); }
  .proof-row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; padding-block: 28px 56px; }
  .proof-row li { display: grid; gap: 6px; align-content: start; }
  .proof-num { font: 500 clamp(36px, 6vw, 56px)/1 var(--f-mono); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .proof-row li > span { color: var(--muted); font-size: 15px; line-height: 1.45; max-width: 24ch; }
  @media (min-width: 900px) { .proof-row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  import { countUp } from "../scripts/motion.js";
  document.querySelectorAll<HTMLElement>(".proof [data-to]").forEach(countUp);
</script>
