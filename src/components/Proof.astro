---
import { PROOF } from "../data/site.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
---
<!-- the numbers set like an infographic key: big figure, an ink tick, the plain fact -->
<section class="proof" aria-label={lang === "id" ? "Bukti" : "Proof"}>
  <ul class="in proof-row marks">
    {PROOF.map(p => (
      <li class="rv">
        <strong class="proof-num">{p.word ?? <span data-to={p.value}>{p.value}</span>}</strong>
        <span>{t(p.label, lang)}</span>
      </li>
    ))}
  </ul>
</section>

<style is:global>
  .proof { padding-block: clamp(56px, 8vw, 96px); }
  .proof-row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; padding-block: 8px; }
  .proof-row li { display: grid; gap: 10px; align-content: start; }
  .proof-num { font: 700 clamp(52px, 6.6vw, 88px)/.95 var(--f-display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .proof-row li::after { content: ""; order: 1; width: 28px; height: 3px; background: var(--accent); }
  .proof-row li > span { order: 2; font: 500 16px/1.4 var(--f-label); max-width: 22ch; }
  @media (min-width: 900px) { .proof-row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  import { countUp } from "../scripts/motion.js";
  document.querySelectorAll<HTMLElement>(".proof [data-to]").forEach(countUp);
</script>
