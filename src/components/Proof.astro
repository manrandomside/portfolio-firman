---
import { PROOF, UI } from "../data/site.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
---
<!-- the numbers set like an infographic key: big figure, an ink tick, the plain fact; the certificate opens on click -->
<section class="proof" aria-label={lang === "id" ? "Bukti" : "Proof"}>
  <ul class="in proof-row marks">
    {PROOF.map(p => (
      <li class="rv">
        {p.cert
          ? <button type="button" class="proof-btn" data-cert={p.cert} aria-haspopup="dialog" data-cursor={t(UI.cert.view, lang)}>
              <strong class="proof-num">{p.word}</strong>
              <span class="proof-tick" aria-hidden="true"></span>
              <span class="proof-label">{t(p.label, lang)}</span>
              <span class="proof-more">{t(UI.cert.view, lang)} →</span>
            </button>
          : <div class="proof-item">
              <strong class="proof-num"><span data-to={p.value}>{p.value}</span></strong>
              <span class="proof-tick" aria-hidden="true"></span>
              <span class="proof-label">{t(p.label, lang)}</span>
            </div>}
      </li>
    ))}
  </ul>
</section>

<style is:global>
  .proof { padding-block: clamp(56px, 8vw, 96px); }
  .proof-row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; padding-block: 8px; }
  .proof-item, .proof-btn { display: grid; gap: 12px; align-content: start; justify-items: start; }
  .proof-btn { all: unset; display: grid; gap: 12px; justify-items: start; cursor: pointer; }
  .proof-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 8px; border-radius: 6px; }
  .proof-num { font: 800 clamp(64px, 9vw, 128px)/.9 var(--f-display); letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
  .proof-tick { width: 28px; height: 3px; background: var(--accent); transition: width .5s var(--ease); }
  .proof-btn:hover .proof-tick { width: 72px; }
  .proof-label { font: 500 17px/1.45 var(--f-body); max-width: 30ch; }
  .proof-more { font: 500 14px var(--f-body); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (min-width: 760px) { .proof-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  import { countUp } from "../scripts/motion.js";
  document.querySelectorAll<HTMLElement>(".proof [data-to]").forEach(countUp);
</script>
