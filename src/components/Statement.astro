---
import { UI } from "../data/site.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
const words = t(UI.statement, lang).split(" ");
---
<!-- One sentence about how Firman sees the work; its words light up one by one while it is read. -->
<section class="s statement">
  <p class="in statement-text" id="statement">{words.map((w, i) => <span style={`--w:${i}`}>{w} </span>)}</p>
</section>

<style is:global>
  .statement-text { margin: 0 auto; font: 800 clamp(30px, 4.2vw, 58px)/1.08 var(--f-display); letter-spacing: -.04em; text-wrap: balance; }
  /* unlit words stay readable (about 3:1, fine for text this large) */
  .js .statement-text span { color: color-mix(in srgb, var(--ink) 48%, var(--bg)); transition: color .35s; }
  .js .statement-text span.lit { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .js .statement-text span { color: var(--ink); } }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  const text = document.getElementById("statement")!;
  const words = [...text.querySelectorAll("span")];
  // lit share follows the paragraph from entering the lower screen to passing its middle
  const update = () => {
    const r = text.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * .85 - r.top) / (r.height + innerHeight * .35)));
    const n = Math.round(p * words.length);
    words.forEach((w, i) => w.classList.toggle("lit", i < n));
  };
  if (!REDUCE) {
    let raf = 0;
    addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
