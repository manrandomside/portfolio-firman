---
import WorkGrid from "./WorkGrid.astro";
import { PROJECTS, FEATURED, UI } from "../data/site.js";
import { featured } from "../lib/projects.js";
import { t } from "../lib/i18n.js";

const { lang } = Astro.props;
---
<section class="s dark" id="karya">
  <div class="in marks">
    <div class="s-head">
      <h2>{t(UI.work.title[0], lang)} <em>{t(UI.work.title[1], lang)}</em></h2>
    </div>
    <WorkGrid lang={lang} projects={featured(PROJECTS, FEATURED)} />
    <p class="more"><a class="btn" href={lang === "id" ? "/karya/" : "/en/work/"}>{t(UI.work.all, lang)} →</a></p>
  </div>
</section>

<style is:global>
  .more { margin-top: 48px; }
  /* five works as a bento: the client site runs wide on the first row, four more below */
  @media (min-width: 1000px) {
    #karya .cards { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    #karya .cards li { grid-column: span 2; }
    #karya .cards li:nth-child(1) { grid-column: span 4; }
    #karya .cards li:nth-child(4), #karya .cards li:nth-child(5) { grid-column: span 3; }
    #karya .cards li:nth-child(1) .card-media { aspect-ratio: auto; height: clamp(220px, 22vw, 300px); }
    #karya .cards li:nth-child(2) .card-media, #karya .cards li:nth-child(3) .card-media { height: clamp(220px, 22vw, 300px); aspect-ratio: auto; }
  }
</style>
