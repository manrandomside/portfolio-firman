---
import { Image } from "astro:assets";
import { UI } from "../data/site.js";
import { t } from "../lib/i18n.js";
import jwd from "../assets/certs/bnsp-jwd.jpg";
import jwdUnits from "../assets/certs/bnsp-jwd-units.jpg";
import jc from "../assets/certs/bnsp-jc.jpg";
import jcUnits from "../assets/certs/bnsp-jc-units.jpg";
import nf from "../assets/certs/nf-sib.jpg";
import nfTranscript from "../assets/certs/nf-sib-transcript.jpg";
import ilIntern from "../assets/certs/il-intern.jpg";
import ilMandiri from "../assets/certs/il-mandiri.jpg";
import ilTranscript from "../assets/certs/il-transcript.jpg";

const { lang } = Astro.props;
const C = UI.cert;
// key matches CERTS[].cert in site.js and the #cert-<key> link; landscape certificates stack in one column
const certs = [
  { key: "bnsp-jwd", title: C.jwd.title, pages: [[jwd, C.jwd.front], [jwdUnits, C.units]] },
  { key: "bnsp-jc", title: C.jc.title, pages: [[jc, C.jc.front], [jcUnits, C.units]] },
  { key: "nf-sib", title: C.nf.title, wide: true, pages: [[nf, C.nf.front], [nfTranscript, C.transcript]] },
  { key: "il-ai", title: C.il.title, wide: true, pages: [[ilIntern, C.il.front], [ilMandiri, C.il.mandiri], [ilTranscript, C.transcript]] }
];
---
<!-- certificates, each opened by a [data-cert="<key>"] button or a #cert-<key> link -->
{certs.map(c => (
  <dialog class="cert" id={`cert-${c.key}`} data-lenis-prevent aria-labelledby={`cert-title-${c.key}`}>
    <div class="cert-in">
      <div class="cert-top">
        <h2 id={`cert-title-${c.key}`}>{t(c.title, lang)}</h2>
        <button type="button" class="cert-close" data-close aria-label={t(UI.cert.close, lang)}>×</button>
      </div>
      <div class:list={["cert-pages", c.wide && "wide"]}>
        {c.pages.map(([src, alt]) => <Image src={src} alt={t(alt, lang)} widths={[600, 1000]} sizes={c.wide ? "(min-width: 900px) 880px, 94vw" : "(min-width: 900px) 420px, 90vw"} />)}
      </div>
    </div>
  </dialog>
))}

<style is:global>
  .cert { width: min(940px, calc(100% - 24px)); max-height: calc(100dvh - 24px); margin: auto; padding: 0; border: 0; border-radius: 14px; background: var(--bg); color: var(--ink); overflow: auto; overscroll-behavior: contain; }
  .cert::backdrop { background: rgba(14, 14, 14, .7); backdrop-filter: blur(4px); }
  .cert[open] { animation: certIn .55s var(--ease); }
  @keyframes certIn { from { opacity: 0; transform: translateY(24px) scale(.98); } }
  .cert-in { display: grid; gap: 18px; padding: 20px clamp(16px, 3vw, 28px) 28px; }
  .cert-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .cert-top h2 { font-size: clamp(22px, 3vw, 30px); line-height: 1.1; }
  .cert-close { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--ink); color: var(--bg); font-size: 24px; line-height: 1; }
  .cert-pages { display: grid; gap: 16px; }
  .cert-pages img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  @media (min-width: 760px) { .cert-pages:not(.wide) { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  import { lockScroll } from "../scripts/motion.js";

  document.addEventListener("click", e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-cert]");
    const d = btn ? (document.getElementById(`cert-${btn.dataset.cert}`) as HTMLDialogElement | null) : null;
    if (!btn || !d) return;
    d.showModal();
    lockScroll(true);
    d.addEventListener("close", () => { lockScroll(false); btn.focus(); }, { once: true });
  });
  document.querySelectorAll<HTMLDialogElement>("dialog.cert").forEach(d =>
    d.addEventListener("click", e => { if (e.target === d || (e.target as HTMLElement).closest("[data-close]")) d.close(); }));

  // a link like firmanfadilah.pages.dev/#cert-bnsp-jwd (used as the credential URL on job sites) opens that certificate
  const linked = location.hash && document.querySelector<HTMLDialogElement>(`dialog.cert#${CSS.escape(location.hash.slice(1))}`);
  if (linked) { linked.showModal(); lockScroll(true); linked.addEventListener("close", () => lockScroll(false), { once: true }); }
</script>
