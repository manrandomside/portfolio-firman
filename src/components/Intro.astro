<!-- Short opening: the name mark rises letter by letter, then the panel lifts away. Once per visit, never with reduced motion. -->
<div class="intro" aria-hidden="true">
  <p class="intro-mark">{[..."firman"].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}<span class="dot" style="--i:6">.</span></p>
</div>

<style is:global>
  .intro { display: none; }
  .js .intro.play { display: grid; place-items: center; position: fixed; inset: 0; z-index: 100; background: var(--dark); color: var(--on-dark); animation: introLift .6s var(--ease) .55s forwards; }
  .intro-mark { margin: 0; font: 700 clamp(44px, 11vw, 120px)/1 var(--f-display); letter-spacing: -.03em; overflow: hidden; padding-bottom: .1em; }
  .intro-mark span { display: inline-block; transform: translateY(110%); animation: introRise .6s var(--ease) calc(var(--i) * .05s) forwards; }
  .intro-mark .dot { color: var(--accent); }
  @keyframes introRise { to { transform: none; } }
  @keyframes introLift { to { transform: translateY(-100%); visibility: hidden; } }
</style>

<script is:inline>
  (() => {
    const el = document.querySelector(".intro");
    let seen = false;
    try { seen = sessionStorage.getItem("intro") === "1"; sessionStorage.setItem("intro", "1"); } catch {}
    if (seen || matchMedia("(prefers-reduced-motion: reduce)").matches) return el.remove();
    el.classList.add("play");
    setTimeout(() => el.remove(), 1200);
  })();
</script>
