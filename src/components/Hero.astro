---
import { Image } from "astro:assets";
import { UI } from "../data/site.js";
import { t, waLink } from "../lib/i18n.js";
import { img } from "../data/images.js";

const { lang } = Astro.props;
const notes = UI.hero.notes;
// two notes sit left of the phone, two right of it; on phones they become a numbered legend under it
const side = (i: number) => (i % 2 === 0 ? "l" : "r");
---
<section class="hero" aria-labelledby="hero-title">
  <div class="in hero-grid marks">
    <div class="hero-copy">
      <h1 id="hero-title"><span class="hl">{t(UI.hero.title[0], lang)}</span> <em class="hl">{t(UI.hero.title[1], lang)}</em></h1>
      <p class="lead hero-lead fade" style="--d:.45s">{t(UI.hero.lead, lang)}</p>
      <div class="ctas hero-ctas fade" style="--d:.6s">
        <a class="btn wa" href={waLink(lang)} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
          {t(UI.hero.wa, lang)}
        </a>
        <a class="text-link" href="#contoh">{t(UI.hero.example, lang)} ↓</a>
      </div>
      <p class="label hero-sign fade" style="--d:.75s">{t(UI.hero.sign, lang)}</p>
    </div>

    <figure class="annot" data-annotate>
      <a class="annot-phone" href="https://earlybeauty.pages.dev" target="_blank" rel="noopener" data-cursor={t(UI.flow.live, lang)}>
        <Image src={img("shots/early-beauty-phone")} alt={t(UI.hero.phoneAlt, lang)} widths={[300, 560]} sizes="(min-width: 900px) 260px, 56vw" loading="eager" fetchpriority="high" />
        {notes.map((n, i) => <span class="pin callout-n" style={`--x:${n.at[0]}%;--y:${n.at[1]}%;--i:${i}`} aria-hidden="true">{i + 1}</span>)}
      </a>
      <figcaption>
        <ol class="notes">
          {notes.map((n, i) => <li class:list={["note", `note-${side(i)}`]} style={`--i:${i}`}><span class="callout-n" aria-hidden="true">{i + 1}</span><span>{t(n.text, lang)}</span></li>)}
        </ol>
      </figcaption>
      <svg class="leaders" aria-hidden="true"></svg>
    </figure>
  </div>
</section>

<style is:global>
  .hero { position: relative; overflow: clip; }
  .hero-grid { display: grid; gap: clamp(36px, 6vw, 56px); padding-block: clamp(40px, 7vw, 72px); margin-block: 18px; }
  .hero h1 { font-size: clamp(42px, 5vw, 76px); line-height: .98; letter-spacing: -.045em; }
  .hero .hl { display: block; }
  .hero-lead { margin-top: 26px; font-size: clamp(18px, 2vw, 21px); color: var(--ink); max-width: 34ch; }
  .hero-ctas { margin-top: 30px; align-items: center; gap: 22px; }
  .text-link { font: 500 16px var(--f-label); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .text-link:hover { color: var(--accent-ink); }
  .hero-sign { margin-top: 34px; }

  /* the headline is set line by line, the rest follows it */
  .js .hero .hl { animation: heroLine .9s var(--ease) both; }
  .js .hero em.hl { animation-delay: .12s; }
  @keyframes heroLine { from { opacity: 0; transform: translateY(.3em); } }
  .js .hero .fade { animation: heroFade .8s var(--ease) var(--d, .3s) both; }
  @keyframes heroFade { from { opacity: 0; transform: translateY(14px); } }

  /* the annotated phone: numbered pins on the screen, notes in the margins, leader lines drawn between them */
  .annot { position: relative; margin: 0; display: grid; justify-items: center; gap: 24px; }
  .annot-phone { position: relative; display: block; width: min(56vw, 250px); border: 8px solid var(--ink); border-radius: 30px; background: var(--ink); box-shadow: 0 30px 60px -32px rgba(14, 14, 14, .55); }
  .annot-phone img { width: 100%; height: auto; border-radius: 22px; }
  .pin { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; box-shadow: 0 0 0 3px var(--bg); z-index: 2; }
  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; width: 100%; max-width: 420px; }
  .note { display: flex; gap: 12px; align-items: flex-start; font: 500 15px/1.35 var(--f-label); }
  .leaders { display: none; }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; min-height: calc(100svh - 100px); }
    .annot { display: block; height: 640px; }
    .annot-phone { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 236px; }
    .notes { display: contents; }
    .note { position: absolute; width: 128px; flex-direction: column; gap: 8px; font-size: 13px; }
    .note-l { left: 0; }
    .note-r { right: 0; }
    .note:nth-child(1) { top: 22%; } .note:nth-child(2) { top: 6%; } .note:nth-child(3) { top: 50%; } .note:nth-child(4) { top: 30%; }
    .leaders { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 3; }
    .leaders path { fill: none; stroke: var(--accent); stroke-width: 1.5; }
    .leaders circle { fill: var(--accent); }
  }

  /* drawing: lines run out from the notes to the pins once, after the headline has landed */
  .js .annot.armed .pin, .js .annot.armed .note { opacity: 0; }
  .js .annot.drawn .pin { animation: pinIn .45s var(--ease) calc(.9s + var(--i) * .22s) both; }
  .js .annot.drawn .note { animation: noteIn .6s var(--ease) calc(.75s + var(--i) * .22s) both; }
  @keyframes pinIn { from { opacity: 0; scale: .3; } to { opacity: 1; scale: 1; } }
  @keyframes noteIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .leaders path { stroke-dasharray: var(--len); stroke-dashoffset: var(--len); }
  .annot.drawn .leaders path { animation: draw .7s var(--ease) calc(.85s + var(--i) * .22s) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* the opening plays first; the hero's entrance waits behind it */
  html.loading .hero *, html.loading .leaders path { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .js .hero .hl, .js .hero .fade, .js .annot .pin, .js .annot .note { animation: none !important; opacity: 1 !important; }
    .leaders path { stroke-dasharray: none; stroke-dashoffset: 0; }
  }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  const fig = document.querySelector<HTMLElement>("[data-annotate]")!;
  const svg = fig.querySelector<SVGSVGElement>(".leaders")!;
  const pins = [...fig.querySelectorAll<HTMLElement>(".pin")];
  const notes = [...fig.querySelectorAll<HTMLElement>(".note")];
  const wide = matchMedia("(min-width: 900px)");

  // one elbow line per note: out from the note's edge facing the phone, then straight to its pin
  function draw() {
    svg.innerHTML = "";
    if (!wide.matches) return;
    const box = fig.getBoundingClientRect();
    notes.forEach((note, i) => {
      const n = note.getBoundingClientRect(), p = pins[i].getBoundingClientRect();
      const left = note.classList.contains("note-l");
      const sx = (left ? n.right + 10 : n.left - 10) - box.left, sy = n.top + 11 - box.top;
      const ex = p.left + p.width / 2 - box.left, ey = p.top + p.height / 2 - box.top;
      const kx = sx + (left ? 24 : -24);
      const len = Math.abs(kx - sx) + Math.hypot(ex - kx, ey - sy);
      svg.insertAdjacentHTML("beforeend", `<path d="M${sx} ${sy} H${kx} L${ex} ${ey}" style="--len:${len.toFixed(1)};--i:${i}"/><circle cx="${sx}" cy="${sy}" r="2.5"/>`);
    });
  }

  draw();
  addEventListener("resize", draw);
  document.fonts?.ready.then(draw);
  // shown at once without motion; otherwise drawn after the headline lands
  if (!REDUCE) {
    fig.classList.add("armed");
    requestAnimationFrame(() => fig.classList.add("drawn"));
  }
</script>
