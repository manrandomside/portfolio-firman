---
import { Image } from "astro:assets";
import { ME, UI } from "../data/site.js";
import { t } from "../lib/i18n.js";
import { img } from "../data/images.js";

const { lang } = Astro.props;
const photo = img(ME.photo);
---
<section class="s about" id="tentang">
  <div class="in about-grid">
    <div class="about-photo rv">
      {photo
        ? <Image src={photo} alt={ME.name} widths={[400, 800]} sizes="(min-width: 900px) 380px, 80vw" />
        : <div class="photo-slot mono">{t(UI.about.photo, lang)}</div>}
    </div>
    <div class="about-text">
      <div class="s-head">
        <p class="eyebrow">{t(UI.about.eyebrow, lang)}</p>
        <h2>{t(UI.about.title, lang)}</h2>
      </div>
      {t(UI.about.body, lang).map(p => <p class="about-p rv">{p}</p>)}
      <dl class="facts rv">
        {UI.about.facts.map(f => <div><dt class="mono">{t(f.k, lang)}</dt><dd>{t(f.v, lang)}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<style is:global>
  .about-grid { display: grid; gap: 40px; }
  .about-photo img, .photo-slot { width: 100%; max-width: 380px; aspect-ratio: 4 / 5; border-radius: 10px; object-fit: cover; }
  .photo-slot { display: grid; place-items: center; border: 1.5px dashed var(--muted); color: var(--muted); font-size: 13px; }
  .about-text .s-head { margin-bottom: 24px; }
  .about-p { max-width: 58ch; margin-bottom: 16px; }
  .facts { display: grid; gap: 0; margin: 28px 0 0; max-width: 560px; }
  .facts div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); }
  .facts dt { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  .facts dd { margin: 0; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 380px minmax(0, 1fr); gap: 72px; align-items: start; } }
</style>
